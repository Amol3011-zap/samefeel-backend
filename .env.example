# Copy to .env for local use. On Railway, set these in the service Variables tab.
# Never commit real values.

DATABASE_URL=
DEBUG=false

# Required, no default. Exact frontend origins, comma-separated, https only.
ALLOWED_ORIGINS=https://samefeel.co,https://www.samefeel.co
# Local development only (allows http://localhost origins):
# ALLOW_DEV_ORIGINS=true

# Protects GET /api/early-access/admin (X-Admin-Key header). Optional but
# recommended — without it that endpoint is unreachable (fails closed).
ADMIN_SECRET=

# Email (SMTP), used for early-access welcome + admin notification emails.
# If unset, the API starts and email sending reports a config error (signup still succeeds).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@samefeel.co
SMTP_FROM_NAME=SameFeel
ADMIN_EMAIL=support@samefeel.co

# Set once the Railway public domain exists
TRUSTED_PROXY_IPS=
